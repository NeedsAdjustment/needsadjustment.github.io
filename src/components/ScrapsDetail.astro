---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { formatDate } from '../lib/scraps.ts';

interface Props {
  scraps: CollectionEntry<'scraps'>[];
  slug: string;
}

const { scraps, slug } = Astro.props;

const index = scraps.findIndex((s) => s.id === slug);
const current = index >= 0 ? scraps[index] : null;
const rendered = current ? await render(current) : null;

const detailDate = current ? formatDate(current.data.date) : undefined;
const detailDatetime = current?.data.date?.toISOString();
---

{
  current && rendered ? (
    <article class="scrap-item detail">
      <div class="scrap-content">
        <div class="scrap-heading">
          <div class="scrap-left">
            <b>{current.data.title}</b>
          </div>
          {detailDate && <time class="scrap-date" datetime={detailDatetime}>{detailDate}</time>}
        </div>
        <div class="scrap-body">
          <rendered.Content />
        </div>
      </div>
    </article>
  ) : (
    <p>Scrap not found.</p>
  )
}

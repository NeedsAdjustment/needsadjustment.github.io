<div id="now-playing" class="now-playing np-hidden">
  <button type="button" class="np-tab" aria-expanded="true" aria-controls="np-collapse">
    listening
  </button>
  <div id="np-collapse" class="np-collapse">
    <a class="np-inner" target="_blank" rel="noopener noreferrer">
      <img id="np-art" class="np-art" src="" alt="" />
      <span class="np-info">
        <span id="np-track" class="np-track"></span>
        <span id="np-artist" class="np-artist"></span>
        <span data-sr> — search on YouTube</span>
      </span>
    </a>
  </div>
</div>

<style>
  .now-playing {
    opacity: 1;
    font-family: 'Lilex Duo', sans-serif;
    max-width: 15rem;
  }

  .now-playing.np-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .np-tab {
    appearance: none;
    position: relative;
    z-index: 0;
    user-select: none;
    color: inherit;
    font-family: inherit;
    background: var(--pill-surface);
    border: var(--pill-border);
    border-bottom: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--pill-shadow);
    padding: var(--space-xs) var(--space-sm) var(--space-md) var(--space-sm);
    margin-bottom: calc(-1 * var(--radius-lg));
    width: min-content;
    font-size: 0.8rem;
    cursor: pointer;
    transition: var(--pill-transition);
  }

  .np-tab:hover {
    background: var(--pill-surface-hover);
    box-shadow: var(--pill-shadow-hover);
  }

  .np-tab:disabled {
    color: inherit;
    cursor: default;
  }

  .np-collapse {
    position: relative;
    z-index: 1;
    max-height: var(--np-open-height, 20rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--pill-shadow);
    transition: max-height 0.3s ease;
  }

  .now-playing:has(.np-inner:hover) .np-collapse {
    box-shadow: var(--pill-shadow-hover);
  }

  .np-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    background: var(--panel-surface);
    border: var(--pill-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .np-inner:hover {
    background: var(--panel-surface-hover);
  }

  .np-art,
  .np-info {
    transition: opacity 0.15s ease;
  }

  .now-playing.np-instant,
  .now-playing.np-instant * {
    transition: none !important;
  }

  .np-art {
    user-select: none;
    height: calc(2.4rem + var(--space-xs) + 1.92rem);
    aspect-ratio: 1 / 1;
    border-radius: calc(var(--radius-lg) - var(--space-sm));
    object-fit: cover;
    flex-shrink: 0;
  }

  .np-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    gap: var(--space-xs);
  }

  .np-info::selection {
    background: var(--background-color);
  }

  .np-track {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .np-artist {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--link-colour);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .now-playing.np-collapsible .np-tab {
    border-bottom: var(--pill-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--pill-transition), border-radius 0.3s ease, border-bottom 0.3s ease, margin 0.3s ease, padding 0.3s ease;
    transition-delay: 0.15s;
  }

  .now-playing.np-collapsible.np-open .np-tab {
    border-bottom: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    margin-bottom: calc(-1 * var(--radius-lg) + var(--space-xs));
    padding: var(--space-xs) var(--space-sm) var(--space-md) var(--space-sm);
    transition-delay: 0s;
  }

  .now-playing.np-collapsible .np-collapse {
    max-height: 0;
    transition-delay: 0.15s;
  }

  .now-playing.np-collapsible.np-open .np-collapse {
    max-height: var(--np-open-height, 20rem);
    transition-delay: 0s;
  }

  .now-playing.np-collapsible .np-art,
  .now-playing.np-collapsible .np-info {
    opacity: 0;
  }

  .now-playing.np-collapsible.np-open .np-art,
  .now-playing.np-collapsible.np-open .np-info {
    opacity: 1;
    transition-delay: 0.3s;
  }
</style>

<script>
  const NOW_PLAYING_PROXY_URL = "https://sprenlastplayed.val.run/";
  const LS_KEY = "lastPlayedTrack";

  function readSession(key: string) {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writeSession(key: string, value: string | null) {
    try {
      if (value === null) sessionStorage.removeItem(key);
      else sessionStorage.setItem(key, value);
    } catch {}
  }

  const el = document.querySelector<HTMLElement>(".now-playing")!;
  const npInner = document.querySelector<HTMLAnchorElement>(".np-inner");
  const npCollapse = document.querySelector<HTMLElement>(".np-collapse");
  const art = document.querySelector<HTMLImageElement>(".np-art");
  const track = document.querySelector<HTMLElement>(".np-track");
  const artist = document.querySelector<HTMLElement>(".np-artist");
  const npTab = document.querySelector<HTMLButtonElement>(".np-tab");

  function hasTrack(data: { shortenedName: string | null; }) {
    return data?.shortenedName && data.shortenedName !== "Currently Not Playing";
  }

  function displayTrack(data: { image: string; shortenedName: string | null; formattedArtist: string | null; }) {
    if (!data || !hasTrack(data)) {
      el?.classList.add("np-hidden");
      npInner?.removeAttribute("href");
      return;
    }

    if (!art || !track || !artist) return;

    art.src = data.image || "";
    track.textContent = data.shortenedName;
    artist.textContent = data.formattedArtist;

    if (npInner) {
      const query = encodeURIComponent(`${data.shortenedName} - ${data.formattedArtist ?? ""}`);
      npInner.href = `https://www.youtube.com/results?search_query=${query}`;
    }

    el?.classList.remove("np-hidden");
  }

  let refreshToken = 0;

  async function refresh() {
    const token = ++refreshToken;
    let data = null;

    try {
      const res = await fetch(NOW_PLAYING_PROXY_URL);
      if (!res.ok) throw new Error(`Proxy error: ${res.status}`);
      data = await res.json();
    } catch {}

    if (token !== refreshToken) return;

    if (hasTrack(data)) {
      try {
        localStorage.setItem(LS_KEY, JSON.stringify(data));
      } catch {}
      displayTrack(data);
      return;
    }

    try {
      const local = JSON.parse(localStorage.getItem(LS_KEY) || "null");
      if (local && hasTrack(local)) {
        displayTrack(local);
        return;
      }
    } catch {}

    el?.classList.add("np-hidden");
  }

  function wireNowPlaying() {
    npTab?.addEventListener("click", () => {
      if (!el?.classList.contains('np-collapsible')) return
      setOpenHeight()
      setOpenState(!el.classList.contains('np-open'))
      writeSession('np-open', el.classList.contains('np-open') ? '1' : '0')
    })
  }

  function setOpenState(open: boolean) {
    el.classList.toggle('np-open', open)
    if (npCollapse) npCollapse.inert = !open
    npTab?.setAttribute('aria-expanded', String(open))
  }

  function isHome() {
    return location.pathname === '/';
  }

  let openHeightTimer: ReturnType<typeof setTimeout> | undefined;
  function setOpenHeight() {
    if (!el) return;
    const inner = el.querySelector('.np-inner');
    if (!inner) return;
    // The inner stays full-size inside the clipping wrapper.
    el.style.setProperty('--np-open-height', `${inner.getBoundingClientRect().height}px`);
    void el.offsetWidth;
    clearTimeout(openHeightTimer);
    openHeightTimer = setTimeout(() => el.style.removeProperty('--np-open-height'), 500);
  }

  function updateCollapsible(animate = true) {
    if (!el) return;
    if (!animate) el.classList.add('np-instant');
    else setOpenHeight();
    const home = isHome();
    if (home) {
      el.classList.remove('np-collapsible');
      setOpenState(true);
      writeSession('np-open', null);
    } else {
      el.classList.add('np-collapsible');
      setOpenState(readSession('np-open') === '1');
    }
    if (npTab) npTab.disabled = home;
    if (!animate) {
      void el.offsetWidth;
      requestAnimationFrame(() => el.classList.remove('np-instant'));
    }
  }

  wireNowPlaying();
  updateCollapsible(false);
  refresh();

  document.addEventListener('astro:after-swap', () => {
    requestAnimationFrame(() => updateCollapsible());
    refresh();
  });
</script>



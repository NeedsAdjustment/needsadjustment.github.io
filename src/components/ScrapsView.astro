---
import { getCollection } from 'astro:content';
import ScrapsList from './ScrapsList.astro';
import ScrapsDetail from './ScrapsDetail.astro';
import { sortScrapsNewestFirst } from '../lib/scraps.ts';

interface Props {
  slug?: string;
}

const { slug } = Astro.props;

const allScraps = await getCollection('scraps');
const scraps = sortScrapsNewestFirst(allScraps);
---

<div id="view-scraps" class="view-scraps-hidden" data-lenis-prevent transition:animate="fade">
  {slug ? <ScrapsDetail scraps={scraps} slug={slug} /> : <ScrapsList scraps={scraps} />}
</div>

<script>
  function showScraps() {
    const view = document.getElementById('view-scraps')
    if (!view) return
    // Always wait for header-settled — it fires immediately on initial load
    // and after the flip animation completes on navigations, so
    // --header-height is always correct when the content appears.
    document.addEventListener('header-settled', function onSettled() {
      document.removeEventListener('header-settled', onSettled)
      view.classList.remove('view-scraps-hidden')
    })
  }
  showScraps()
  document.addEventListener('astro:page-load', showScraps)
</script>

<style is:global>
  #view-scraps.view-scraps-hidden {
    opacity: 0;
    pointer-events: none;
  }

  #view-scraps {
    position: fixed;
    width: 100vw;
    height: calc(100dvh - var(--header-height) - 2rem);
    padding-top: calc(var(--header-height) + 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    max-width: 1600px;
    z-index: 5;
    overflow-y: scroll;
    scrollbar-width: none;
  }

  .scrap-list {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 80%;
    gap: 1rem;
  }

  .scrap-item {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .scrap-item.detail {
    width: 80%;
  }

  a.scrap-item {
    cursor: pointer;
  }

  .scrap-left {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-color);
    opacity: 0.75;
    flex: 1;
    min-width: 0;
  }

  .scrap-left > b {
    color: var(--text-color);
    opacity: 1;
  }
  a.scrap-item:hover > .scrap-left > b {
    color: var(--link-colour);
  }

  .scrap-date {
    flex-shrink: 0;
  }

  .scrap-body {
    line-height: 1.5rem;
    text-align: justify;
    text-wrap: pretty;
  }

  .scrap-body .email span:nth-child(odd) {
    display: none;
  }

  .scrap-nav {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-basis: 100%;
  }
  .scrap-nav a {
    cursor: pointer;
    color: var(--link-colour);
    text-decoration: none;
  }
  .scrap-nav a:hover {
    text-decoration: underline;
  }
  .scrap-nav a[data-disabled] {
    color: var(--ui-border);
    cursor: default;
  }
  .scrap-nav a[data-disabled]:hover {
    text-decoration: none;
  }
  .scrap-nav-list {
    text-align: center;
  }

  @media (max-width: 500px) {
    .scrap-excerpt {
      display: none;
    }
  }
</style>

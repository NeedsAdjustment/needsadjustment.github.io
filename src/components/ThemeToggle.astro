
<div class='ThemeToggle'>
  <fieldset class="toggle-group" id="colorScheme" aria-label="Color scheme">
    <label title="Light Mode">
      <input type="radio" name="color-scheme" id="light" value="0" data-sr />
      <div class="icon-container">
        <i class="ph ph-sun regular-icon" aria-hidden="true"></i>
        <i class="ph-fill ph-sun filled-icon" aria-hidden="true"></i>
      </div>
      <span data-sr>Light</span>
    </label>
    <label title="Dark Mode">
      <input type="radio" name="color-scheme" id="dark" value="1" data-sr />
      <div class="icon-container">
        <i class="ph ph-moon regular-icon" aria-hidden="true"></i>
        <i class="ph-fill ph-moon filled-icon" aria-hidden="true"></i>
      </div>
      <span data-sr>Dark</span>
    </label>
  </fieldset>
</div>

<style>

  .toggle-group {
    inline-size: fit-content;
    padding: var(--space-xs);
    margin: 0;
    border: var(--pill-border);
    border-radius: var(--radius-full);
    background: var(--pill-surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--pill-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: var(--theme-transition);
  }

  .toggle-group label {
    border-radius: var(--radius-full);
    cursor: pointer;
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    user-select: none;
    line-height: 1;
    position: relative;
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid transparent;
    transition: var(--theme-transition);
  }

  .toggle-group label:has(input:checked) {
    background-color: color-mix(in srgb, var(--toggle-accent-color) 18%, var(--pill-surface));
    border-color: color-mix(in srgb, var(--toggle-accent-color) 45%, var(--ui-border));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .toggle-group label:has(input:focus-visible) {
    outline: 2px solid var(--link-colour);
    outline-offset: 2px;
  }

  .icon-container {
    position: relative;
    width: 1.5em;
    height: 1.5em;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .toggle-group .ph {
    font-size: 1.25rem;
    position: absolute;
    line-height: 1;
  }

  .regular-icon,
  .filled-icon {
    transition: opacity 0.2s ease;
  }

  .regular-icon {
    opacity: 1;
  }

  .filled-icon {
    opacity: 0;
  }

  .toggle-group label:has(input:checked) .regular-icon,
  .toggle-group label:not(:has(input:checked)):hover .regular-icon {
    opacity: 0;
  }

  .toggle-group label:has(input:checked) .filled-icon,
  .toggle-group label:not(:has(input:checked)):hover .filled-icon {
    opacity: 1;
  }

  .toggle-group label:has(input:checked) .filled-icon {
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.2));
  }
</style>
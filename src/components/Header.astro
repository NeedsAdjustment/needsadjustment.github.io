---

const { scrapCount = 0, scrolled = false } = Astro.props

---

<header class:list={['hero', { scrolled }]} transition:persist="site-header">
  <h1 aria-label="Joshua Soong">Joshua Soong</h1>
  <nav aria-label="Primary">
    <h2>
      <span class="tera-control">
        <tera class="category" id="leftCreature" aria-hidden="true"></tera>
        <button type="button" class="tera-button" id="leftCreatureButton" aria-label="Back to home"></button>
      </span>
      <a class="category" data-count-key="coding" data-status="loading" href='https://github.com/NeedsAdjustment'><span class="pill-label">coding</span><span class="count-wrap"><num></num></span></a>
      <a class="category" data-scraps data-status="ready" href="/scraps/"><span class="pill-label">scraps</span><span class="count-wrap"><num>{scrapCount}</num></span></a>
      <a class="category" data-snaps data-status="loading" href="/snaps/"><span class="pill-label">snaps</span><span class="count-wrap"><num></num></span><span class="pill-status" data-sr></span></a>
      <a class="category" data-count-key="design" data-status="loading" href='https://dribbble.com/NeedsAdjustment'><span class="pill-label">design</span><span class="count-wrap"><num></num></span></a>
      <span class="tera-control">
        <tera class="category" id="rightCreature" aria-hidden="true"></tera>
        <button type="button" class="tera-button" id="rightCreatureButton" aria-label="Back to home"></button>
      </span>
    </h2>
  </nav>
  <button type="button" class="scroll-indicator" aria-label="Read intro">
    <i class="arrow1 ph-bold ph-caret-down" aria-hidden="true"></i>
    <i class="arrow2 ph-bold ph-caret-down" aria-hidden="true"></i>
  </button>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    width: 100%;
    max-width: 1200px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    -webkit-user-select: none;
    user-select: none;
    transition: transform 0.4s ease, top 0.4s ease;
    gap: clamp(0.1rem, 0.5rem, 20px);
  }

  header.scrolled {
    gap: 0;
  }

  header.hero {
    top: 50%;
    transform: translateY(-50%);
  }

  header.hero.scrolled {
    top: 0;
    transform: none;
  }

  h1 {
    cursor: default;
    font-family: 'Unbounded';
    font-size: clamp(1rem, 10vw, 7.4rem);
    margin: 0;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    max-height: 20rem;
    transition: opacity 0.4s ease, max-height 0.4s ease, margin 0.4s ease, padding 0.4s ease;
  }

  header.hero.scrolled h1 {
    opacity: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
  }

  header.hero.scrolled .scroll-indicator {
    display: none;
  }

  tera {
    user-select: none;
    font-family: 'Teranoptia';
    font-size: 1.5em;
  }

  .tera-control {
    position: relative;
    display: inline-flex;
  }

  .tera-button {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  @media (max-width: 499px) {
    .tera-control {
      display: none;
    }
  }

  nav {
    width: 100%;
  }

  h2 {
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 400;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: space-around;
    align-items: center;
    transition: padding-top 0.4s ease;
  }

  header.hero.scrolled h2 {
    margin: clamp(0rem, 2vw, 1rem) 0;
    padding-bottom: clamp(0rem, 2vw, 1rem);
  }

  header[data-measuring],
  header[data-measuring] * {
    transition: none !important;
  }

  h2 a.category {
    cursor: pointer;
    padding: var(--space-xs) var(--space-sm);
    border: var(--pill-border);
    border-radius: var(--radius-full);
    background: var(--pill-surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--pill-shadow);
    text-decoration: none;
    color: inherit;
    transition: var(--pill-transition);
  }

  h2 a.category:hover {
    background: var(--pill-surface-hover);
    box-shadow: var(--pill-shadow-hover);
  }

  h2 a.category .pill-label {
    display: inline-block;
  }

  h2 a.category[data-status='loading'] .pill-label {
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.2) 0%, rgb(0 0 0 / 0.2) 42%, #000 50%, rgb(0 0 0 / 0.2) 58%, rgb(0 0 0 / 0.2) 100%);
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.2) 0%, rgb(0 0 0 / 0.2) 42%, #000 50%, rgb(0 0 0 / 0.2) 58%, rgb(0 0 0 / 0.2) 100%);
    -webkit-mask-size: 220% 100%;
    mask-size: 220% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: pill-loading 1.4s linear infinite;
  }

  h2 a.category .count-wrap {
    display: inline-grid;
    grid-template-columns: 0fr;
    vertical-align: sub;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-columns 0.24s ease, opacity 0.09s ease 0.16s;
  }

  h2 a.category .count-wrap > num {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  h2 a.category[data-status='ready'] .count-wrap {
    grid-template-columns: 1fr;
    opacity: 1;
  }

  @keyframes pill-loading {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h2 a.category[data-status='loading'] .pill-label {
      -webkit-mask-image: none;
      mask-image: none;
      animation: none;
    }

    h2 a.category .count-wrap {
      transition: none;
    }
  }

  h2 a.category.active {
    background: var(--link-colour);
    border-color: var(--link-colour);
    color: var(--background-color);
  }
  h2 a.category.active num {
    color: var(--background-color);
    font-feature-settings: 'ss04';
  }

  num {
    font-family: 'Unbounded';
    font-weight: 400;
    font-size: 0.8em;
    vertical-align: sub;
    font-feature-settings: 'ss02';
    text-decoration: none;
    color: inherit;
    transition: color 0.5s ease;
  }

  h2 a:hover num {
    color: var(--link-colour);
    font-feature-settings: 'ss04';
  }

  /* Snaps unavailable (Immich unreachable) */
  h2 a.category.unavailable {
    position: relative;
    color: var(--accent-red);
    text-decoration: line-through;
    background: color-mix(in srgb, var(--accent-red) 12%, var(--pill-surface));
    border-color: color-mix(in srgb, var(--accent-red) 45%, var(--ui-border));
  }

  h2 a.category.unavailable:hover,
  h2 a.category.unavailable.active {
    background: color-mix(in srgb, var(--accent-red) 18%, var(--pill-surface));
  }

  h2 a.category.unavailable.active {
    border-color: var(--accent-red);
    color: var(--accent-red);
  }

  h2 a.category.unavailable num {
    display: none;
  }

  h2 a.category.unavailable::after {
    content: 'stupid tailscale';
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent-red);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 20;
  }

  h2 a.category.unavailable:hover::after,
  h2 a.category.unavailable:focus-visible::after {
    opacity: 1;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1em;
    padding: var(--space-sm);
    border: 0;
    background: none;
    font-family: inherit;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1;
    color: var(--text-color);
    cursor: pointer;
  }

  .arrow1 {
    margin-bottom: -0.3em;
    animation: fade-in-out 3s ease-out infinite;
  }

  .arrow2 {
    margin-top: -0.3em;
    animation: fade-in-out 3s ease-out infinite 0.5s;
  }

  @keyframes fade-in-out {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

</style>
